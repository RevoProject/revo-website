<button id="back-to-top" class="back-to-top" type="button" aria-label="Back to top" title="Back to top">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 15L12 10L7 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
<script>
  const button = document.getElementById("back-to-top");
  if (button) {
    const update = () => button.classList.toggle("is-visible", window.scrollY > 90);
    window.addEventListener("scroll", update, { passive: true });
    button.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
    update();
  }
</script>
