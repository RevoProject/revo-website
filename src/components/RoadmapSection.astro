---
import type { SiteContent } from "../lib/product-content";
interface Props { content: SiteContent["roadmap"]; }
const { content } = Astro.props;
---
<section class="section" id="roadmap">
<div class="sectionhead"><div class="kicker">{content.roadmap}</div><h2>{content.whatSNext}</h2><p>{content.milestonesStayVisibleButTheyCome}</p></div>
<div class="timeline">
<div class="timeline-item"><div class="timeline-head"><h3>Q2 — STREAMING CORE</h3><span class="status-badge">{content.inProgress}</span></div><div class="timeline-content"><p class="road-tags">RTMP · SRT · WebRTC</p><p>{content.nativeCapturePipelineStreamOutputAnd}</p></div></div>
<div class="timeline-item"><div class="timeline-head"><h3>{content.q3ProductionLayer}</h3><span class="status-badge">{content.planned}</span></div><div class="timeline-content"><p class="road-tags">{content.scenesSourcesTransitions}</p><p>{content.dynamicSceneSwitchingOverlaysAndProduction}</p></div></div>
<div class="timeline-item"><div class="timeline-head"><h3>Q4 — CROSS-PLATFORM</h3><span class="status-badge">{content.planned2}</span></div><div class="timeline-content"><p class="road-tags">Linux · Windows · macOS</p><p>{content.stableDesktopBuildsAndPlatformSpecific}</p></div></div>
</div>
</section>
