---
import type { SiteContent } from "../lib/product-content";
interface Props { content: SiteContent["sponsors"]; }
const { content } = Astro.props;
---
<section class="sponsors-partners" id="sponsors">
  <div class="wrap">
    <div class="sectionhead" style="margin-bottom: 40px;">
      <span class="kicker">{content.sponsors}</span>
      <h2>{content.partners}</h2>
      <p style="max-width: 720px; color: var(--muted); line-height: 1.7;">{content.shortInfo}</p>
    </div>

    <div class="partners-grid">
      <article class="partner-card main-partner">
        <span class="partner-badge">{content.mainPartner}</span>
        <a href="https://itvt.xyz" target="_blank" rel="noopener noreferrer" class="partner-link">
          <img 
            src="https://i.imgur.com/Sbh3a8O.png" 
            alt={content.itvt}
            class="partner-logo"
            width="150"
            height="auto"
            loading="lazy"
          />
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .sponsors-partners {
    padding: 80px 0;
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    justify-items: center;
  }

  .partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: linear-gradient(180deg, var(--panel), #08111d);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    min-width: 280px;
  }

  .partner-card:hover {
    transform: translateY(-4px);
    border-color: #2c5280;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.18);
  }

  .partner-card.main-partner {
    grid-column: 1 / -1;
    max-width: 520px;
  }

  .partner-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5f91ff;
  }

  .partner-link {
    display: block;
  }

  .partner-logo {
    width: 180px;
    height: auto;
    filter: grayscale(100%) saturate(0.8);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .partner-link:hover .partner-logo {
    filter: grayscale(0%) saturate(1);
    transform: scale(1.02);
  }

  @media (max-width: 900px) {
    .sponsors-partners {
      padding: 60px 0;
    }
    .partner-card {
      padding: 28px;
    }
    .partner-logo {
      width: 160px;
    }
  }

  @media (max-width: 650px) {
    .sponsors-partners {
      padding: 48px 0;
    }
    .partners-grid {
      grid-template-columns: 1fr;
    }
    .partner-card.main-partner {
      max-width: 100%;
    }
    .partner-card {
      min-width: 0;
      padding: 24px;
    }
    .partner-logo {
      width: 140px;
    }
    .sectionhead h2 {
      font-size: 38px;
    }
  }
</style>