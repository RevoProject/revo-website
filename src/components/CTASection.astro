---
import type { SiteContent } from "../lib/product-content";
interface Props { content: SiteContent["hero"]; }
const { content } = Astro.props;
---
<section class="hero">
<div>
<div class="eyebrow"><b>●</b> OPEN SOURCE <span>|</span> LIVE PRODUCTION <span>|</span> RUST</div>
<h1>STREAM<br><span class="grad">{content.withoutLimits}</span></h1>
<p class="lead">{content.theOpenSourceAlternativeToClosed}</p>
<div class="actions"><a class="btn primary" href="https://github.com/RevoProject/revo-stream/releases/latest"><svg viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{content.downloadForLinux}<svg viewBox="0 0 24 24"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a><a class="btn" href="https://github.com/RevoProject/revo-stream"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5a9.7 9.7 0 0 0-3.1 18.9c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.7.4-1.1.6-1.4-2.2-.3-4.5-1.1-4.5-4.8 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.4 9.4 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.7.7 1 1.6 1 2.7 0 3.7-2.3 4.5-4.5 4.8.4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.7 9.7 0 0 0 12 2.5Z"/></svg>{content.viewOnGithub}</a></div>
<div class="available" id="download">
<p>{content.availableFor}</p>
<div class="platforms">
  <div class="platform">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M14.74 15.75c-.57-.24-.82-.57-.79-1.05.02-.5-.25-.87-.39-1.07-.34-.3.3-1.55-.02-2.45-.34-.96-1.28-2.38-2.31-3.82-.4-.56-.42-1.16-.45-1.84-.02-.67-.04-1.42-.42-2.25-.45-1.02-1.3-1.62-2.38-1.62-.67 0-1.37.22-1.91.58-1.1.74-.95 2.45-.85 3.52.02.15.03.29.04.42.06.93 0 1.39-.07 1.55-.05.11-.29.42-.55.76-.27.35-.58.75-.83 1.12-.3.45-.53 1.18-.76 1.85-.17.5-.33.98-.5 1.26-.29.51-.22.98-.16 1.2-.12.08-.3.24-.47.57-.16.34-.48.52-1.17.65-.32.06-.55.2-.66.4-.16.28-.06.64.03.88.13.38.04.61-.1 1.06-.03.1-.07.21-.1.34-.06.2-.03.38.07.53.25.4 1.03.54 1.81.64.48.06 1.01.25 1.52.44.5.19 1.01.37 1.48.43.08.01.15.02.21.02.72 0 1.04-.48 1.15-.67.25-.05 1.1-.21 1.99-.24.88-.02 1.74.16 1.98.22.08.16.28.48.61.65.18.1.42.15.66.15.28 0 .78-.07 1.17-.49.4-.43 1.42-1 2.15-1.4.17-.09.33-.18.46-.25.42-.23.65-.57.63-.91-.02-.29-.21-.55-.5-.67Z"/></svg>
    <span>Linux</span><span class="tag stable">{content.stable}</span>
  </div>
  <div class="platform">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M2 3.6 9 2.55V9H2V3.6Zm8-1.2L18 1.2V9h-8V2.4ZM2 10h7v6.45L2 15.4V10Zm8 0h8v8.8l-8-1.2V10Z"/></svg>
    <span>Windows</span><span class="tag experimental">{content.experimental}</span>
  </div>
  <div class="platform">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M15.57 7.19c-.03-1.75 1.43-2.59 1.5-2.63-.81-1.19-2.08-1.36-2.52-1.38-1.05-.11-2.07.63-2.6.63-.54 0-1.37-.62-2.25-.6-1.16.02-2.23.68-2.83 1.7-1.21 2.1-.31 5.18.86 6.87.58.82 1.26 1.74 2.15 1.71.86-.04 1.19-.56 2.23-.56 1.04 0 1.34.56 2.24.54.93-.02 1.52-.83 2.1-1.65.66-.95.93-1.87.95-1.92-.02-.01-1.81-.7-1.83-2.71ZM13.87 2.07c.48-.58.8-1.38.71-2.18-.69.03-1.52.46-2.02 1.04-.44.5-.83 1.32-.73 2.1.77.06 1.56-.39 2.04-.96Z"/></svg>
    <span>macOS</span><span class="tag experimental">{content.experimental2}</span>
  </div>
</div>
</div>
</div>
</section>
