---
import "../styles/product.css";
import { productContent, type Language } from "../lib/product-content";
import SEOHead from "./SEOHead.astro";
import Header from "./Header.astro";
import CTASection from "./sections/CTASection.astro";
import DemoSection from "./sections/DemoSection.astro";
import FeaturesSection from "./sections/FeaturesSection.astro";
import CapabilitiesSection from "./sections/CapabilitiesSection.astro";
import ProtocolsSection from "./sections/ProtocolsSection.astro";
import WhySection from "./sections/WhySection.astro";
import SwitchSection from "./sections/SwitchSection.astro";
import ComparisonSection from "./sections/ComparisonSection.astro";
import CommunitySection from "./sections/CommunitySection.astro";
import RoadmapSection from "./sections/RoadmapSection.astro";
import MilestonesSection from "./sections/MilestonesSection.astro";
import SponsorsPartners from "./sections/SponsorsPartners.astro";
import Footer from "./Footer.astro";
import BackToTop from "./BackToTop.astro";

interface Props { lang: Language; }
const { lang } = Astro.props;
const content = productContent[lang];
const siteUrl = "https://revostream.in";
const pageUrl = siteUrl + (lang === "en" ? "/" : "/pl/");
const pageTitle = lang === "en" ? "RevoStream — Stream Without Limits" : "RevoStream — Streamuj bez ograniczeń";
const pageDesc = content.hero.theOpenSourceAlternativeToClosed;
---
<!doctype html>
<html lang={lang}>
  <SEOHead {lang} {siteUrl} {pageUrl} {pageTitle} {pageDesc} />
  <body>
    <div class="wrap">
      <Header {lang} content={content.header} />
      <main>
        <CTASection content={content.hero} />
        <DemoSection content={content.demo} />
        <FeaturesSection content={content.features} />
        <CapabilitiesSection content={content.capabilities} />
        <ProtocolsSection content={content.protocols} />
        <WhySection content={content.why} />
        <SwitchSection content={content.switch} />
        <ComparisonSection content={content.comparison} />
        <CommunitySection content={content.community} />
        <RoadmapSection content={content.roadmap} />
        <MilestonesSection content={content.history} />
        <SponsorsPartners content={content.sponsors} />
      </main>
      <Footer />
    </div>
    <BackToTop />
  </body>
</html>
