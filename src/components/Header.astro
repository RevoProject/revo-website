---
import type { SiteContent, Language } from "../lib/product-content";
interface Props { content: SiteContent["header"]; lang: Language; }
const { content, lang } = Astro.props;
---
<nav>
<a class="brand" href="#"><span class="brandmark"><svg viewBox="0 0 40 40"><path fill="currentColor" d="M7 7h15.5C30.5 7 35 11.2 35 17.3c0 5-3.1 8.5-8.1 9.5L35 33H25.8l-7.3-8.1H14V33H7V7Zm7 6v5.9h7.7c2.5 0 4-1.1 4-3s-1.5-2.9-4-2.9H14Z"/><path fill="currentColor" opacity=".72" d="M4 5h5v30H4z"/></svg></span><span>RevoStream</span></a>
<div class="navlinks"><a href="#features">{content.features}</a><a href="#why">{content.whyRevostream}</a><a href="#roadmap">{content.roadmap}</a><a href="#history">{content.history}</a></div>
<div class="navtools">
<button class="iconbtn" id="theme-toggle" type="button" aria-label="Toggle light and dark mode" title="Toggle theme">
  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
</button>
<div class="lang-switcher">
  <button class="lang" id="lang-toggle" type="button" aria-haspopup="true" aria-expanded="false">{lang.toUpperCase()}⌄</button>
  <div class="lang-menu" id="lang-menu">
    <a href="/" data-lang="en">English</a>
    <a href="/pl" data-lang="pl">Polski</a>
  </div>
</div>
<a class="gh" href="https://github.com/RevoProject/revo-stream"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5a9.7 9.7 0 0 0-3.1 18.9c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.7.4-1.1.6-1.4-2.2-.3-4.5-1.1-4.5-4.8 0-1.1.4-2 1-2.7.7-.7 1-1.6 1-2.7 0 0 .8-.3 2.8 1a9.4 9.4 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.7.7 1 1.6 1 2.7 0 3.7-2.3 4.5-4.5 4.8.4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.7 9.7 0 0 0 12 2.5Z"/></svg> GitHub</a>
</div></nav>
<script>
  const root = document.documentElement;
  const themeButton = document.getElementById("theme-toggle");
  const langButton = document.getElementById("lang-toggle");
  const langMenu = document.getElementById("lang-menu");

  themeButton?.addEventListener("click", () => {
    root.classList.toggle("light");
    try {
      localStorage.setItem("revo-theme", root.classList.contains("light") ? "light" : "dark");
    } catch {}
  });

  const closeLanguageMenu = () => {
    langMenu?.classList.remove("is-open");
    langButton?.setAttribute("aria-expanded", "false");
  };
  langButton?.addEventListener("click", () => {
    if (!langMenu) return;
    const open = langMenu.classList.toggle("is-open");
    langButton.setAttribute("aria-expanded", String(open));
  });
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest(".lang-switcher")) closeLanguageMenu();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && langMenu?.classList.contains("is-open")) {
      closeLanguageMenu();
      langButton?.focus();
    }
  });
  document.addEventListener("focusin", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest(".lang-switcher")) closeLanguageMenu();
  });
</script>
