---
import type { SiteContent } from "../lib/product-content";
interface Props { content: SiteContent["history"]; }
const { content } = Astro.props;
---
<section class="section" id="history">
<div class="sectionhead"><div class="kicker">{content.history}</div><h2>{content.builtThroughIteration}</h2><p>{content.revostreamDidnTStartWithA}</p></div>
<div class="history-list">
<div class="history-item"><div class="history-icon"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M8 21h8m-4-3v3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></div><div class="history-content"><h4>{content.firstStepCCore}</h4><p>{content.buildOnCCodePracticalAt}</p></div></div>
<div class="history-item"><div class="history-icon"><svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></div><div class="history-content"><h4>{content.secondStepStreamlabsObsStudioNode}</h4><p>{content.exploredANodeBasedDirectionTied}</p></div></div>
<div class="history-item"><div class="history-icon"><svg viewBox="0 0 24 24"><path d="M9 7V3m6 4V3M7 7h10v3a5 5 0 0 1-10 0V7Zm5 8v6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></div><div class="history-content"><h4>{content.thirdStepLibobsRevoLibRust}</h4><p>{content.useLibobsTodayWhileBuildingRevo}</p></div></div>
</div>
</section>
